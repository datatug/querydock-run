---
import '../styles/site.css';
import Mark from '../components/Mark.astro';
import {copy, type Locale} from '../content';
interface Props {locale:Locale; title:string; description:string; suffix?:string; noindex?:boolean}
const {locale,title,description,suffix='',noindex=false}=Astro.props;
const t=copy[locale]; const other=locale==='en'?'ru':'en'; const path=`/${locale}/${suffix}`;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · QueryDock</title><meta name="description" content={description}/><meta name="theme-color" content="#123e46"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{noindex?<meta name="robots" content="noindex,follow"/>:<><link rel="canonical" href={`https://querydock.run${path}`}/><link rel="alternate" hreflang="en" href={`https://querydock.run/en/${suffix}`}/><link rel="alternate" hreflang="ru" href={`https://querydock.run/ru/${suffix}`}/><link rel="alternate" hreflang="x-default" href={`https://querydock.run/en/${suffix}`}/></>}<meta property="og:type" content="website"/><meta property="og:site_name" content="QueryDock"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={`https://querydock.run${path}`}/><meta property="og:locale" content={locale==='ru'?'ru_RU':'en_US'}/><meta property="og:image" content="https://querydock.run/og-card.svg"/><meta property="og:image:alt" content="QueryDock"/></head><body><a class="skip" href="#main">{t.skip}</a><header class="wrap"><a class="brand" href={`/${locale}/`} aria-label={`QueryDock — ${t.home}`}><Mark/>Query<span>Dock</span><span class="brand-dot"></span></a><nav aria-label={locale==='ru'?'Основная навигация':'Main navigation'}><a href={`/${locale}/`}>SQL</a><a href={`/${locale}/graphql/`}>GraphQL</a><a class="language" href={`/${other}/${suffix}`} lang={other} hreflang={other}>{other==='ru'?'Русский':'English'}</a></nav></header><main id="main"><slot/></main><footer class="wrap"><div><a class="brand" href={`/${locale}/`}><Mark/>QueryDock</a><p>{t.footer}</p></div><nav aria-label={locale==='ru'?'Дополнительные ссылки':'Footer links'}><a href={`/${locale}/privacy/`}>{t.privacy}</a><a href={`/${locale}/terms/`}>{t.terms}</a><a href="https://datatug.app/">DataTug ↗</a></nav><small>© 2026 QueryDock</small></footer></body></html>
