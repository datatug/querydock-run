---
import '../styles/site.css';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import Mark from '../components/Mark.astro';
import {copy, type Locale} from '../content';
interface Props {locale:Locale; title:string; description:string; suffix?:string; noindex?:boolean}
const {locale,title,description,suffix='',noindex=false}=Astro.props;
const t=copy[locale]; const other=locale==='en'?'ru':'en';
const home=(language:Locale)=>language==='en'?'/':'/ru/';
const localized=(language:Locale)=>suffix?`/${language}/${suffix}`:home(language);
const path=localized(locale);
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><script is:inline src="/theme.js"></script><link rel="stylesheet" href="/feedback.css"/><title>{title} · QueryDock</title><meta name="description" content={description}/><meta name="theme-color" content="#123e46"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{noindex?<meta name="robots" content="noindex,follow"/>:<><link rel="canonical" href={`https://querydock.run${path}`}/><link rel="alternate" hreflang="en" href={`https://querydock.run${localized('en')}`}/><link rel="alternate" hreflang="ru" href={`https://querydock.run${localized('ru')}`}/><link rel="alternate" hreflang="x-default" href={`https://querydock.run${localized('en')}`}/></>}<meta property="og:type" content="website"/><meta property="og:site_name" content="QueryDock"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={`https://querydock.run${path}`}/><meta property="og:locale" content={locale==='ru'?'ru_RU':'en_US'}/><meta property="og:image" content="https://querydock.run/og-card.svg"/><meta property="og:image:alt" content="QueryDock"/></head><body><a class="skip" href="#main">{t.skip}</a><header class="wrap"><a class="brand" href={home(locale)} aria-label={`QueryDock — ${t.home}`}><Mark/>Query<span>Dock</span><span class="brand-dot"></span></a><nav aria-label={locale==='ru'?'Основная навигация':'Main navigation'}><label class="theme-choice"><span>{locale==='ru'?'Тема':'Theme'}</span><select id="theme-mode" aria-label={locale==='ru'?'Цветовая тема':'Colour theme'}><option value="auto">{locale==='ru'?'Системная':'System'}</option><option value="light">{locale==='ru'?'Светлая':'Light'}</option><option value="dark">{locale==='ru'?'Тёмная':'Dark'}</option></select></label><a href={home(locale)}>SQL</a><a href={`/${locale}/graphql/`}>GraphQL</a><a class="language" href={localized(other)} lang={other} hreflang={other}>{other==='ru'?'Русский':'English'}</a></nav></header><main id="main"><slot/></main><footer class="wrap"><div><a class="brand" href={home(locale)}><Mark/>QueryDock</a><p>{t.footer}</p></div><nav aria-label={locale==='ru'?'Дополнительные ссылки':'Footer links'}><a href={`/${locale}/privacy/`}>{t.privacy}</a><a href={`/${locale}/terms/`}>{t.terms}</a><a href="https://datatug.app/">DataTug ↗</a></nav><small>© 2026 QueryDock</small></footer><FeedbackWidget locale={locale}/></body></html>
