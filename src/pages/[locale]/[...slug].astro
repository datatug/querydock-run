---
import Layout from '../../layouts/Layout.astro';
import Harbour from '../../components/Harbour.astro';
import {copy,engineCopy,engines,locales,type Locale} from '../../content';
export function getStaticPaths(){return locales.flatMap(locale=>[undefined,'graphql','privacy','terms',...engines.map(e=>`sql/${e}`)].map(slug=>({params:{locale,slug}})));}
const locale=Astro.params.locale as Locale; const slug=Astro.params.slug; const t=copy[locale]; const home=locale==='en'?'/':'/ru/';
const engine=slug?.startsWith('sql/')?engineCopy[slug.split('/')[1] as keyof typeof engineCopy]:undefined;
const detail=engine?.[locale]; const legal=slug==='privacy'||slug==='terms';
const title=engine?`${engine.name} — ${detail!.title}`:slug==='graphql'?t.graphqlTitle:slug==='privacy'?t.privacyTitle:slug==='terms'?t.termsTitle:t.title.replace('\n',' ');
const description=detail?.desc??(slug==='graphql'?t.graphqlText:legal?title:t.description);
---
<Layout locale={locale} title={title} description={description} suffix={slug?`${slug}/`:''}>
{!slug?<><section class="hero wrap"><div class="hero-copy"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="lead">{t.description}</p><a class="button" href="#engines">{t.explore}<span aria-hidden="true">↘</span></a><p class="status"><span class="status-dot"></span>{t.status}</p></div><div class="hero-art"><Harbour label={locale==='ru'?'Причал QueryDock и буксир DataTug':'The QueryDock pier and DataTug tugboat'}/><p class="art-caption">01 — {locale==='ru'?'НА ПУТИ К НОВЫМ ОТКРЫТИЯМ':'A PLACE TO BEGIN EXPLORING'}</p></div></section><section class="engine-section wrap" id="engines"><div class="section-heading"><p class="eyebrow">SQL / {t.soon}</p><h2>{t.engineIntro}</h2><p>{t.engineText}</p></div><div class="engine-list">{engines.map(key=>{const e=engineCopy[key];return <a class="engine-row" href={`/${locale}/sql/${key}/`}><span class="engine-number">{e.tag.slice(0,2)}</span><h3>{e.name}</h3><p>{e[locale].desc}</p><span class="row-arrow" aria-hidden="true">↗</span></a>})}</div></section><section class="family"><div class="wrap family-inner"><p class="eyebrow">QUERYDOCK × DATATUG</p><h2>{t.familyTitle}</h2><div><p>{t.familyText}</p><a class="text-link" href="https://datatug.app/">{t.datatug} <span aria-hidden="true">↗</span></a></div></div></section></>:engine&&detail?<><section class="wrap detail-hero"><a class="back" href={`${home}#engines`}>← {t.engines}</a><p class="eyebrow">{engine.tag} / SQL</p><h1>{engine.name}<span class="subtitle">{detail.title}</span></h1><p class="lead">{detail.desc}</p></section><section class="wrap detail-grid"><div><h2>{t.planned}</h2><p>{detail.detail}</p><p>{detail.use}</p><div class="notice">{t.status}</div><a class="button" href={`/${locale}/sql/${slug!.split('/')[1]}/run/`}>{locale==='ru'?'Открыть SQL-песочницу':'Open SQL playground'} ↗</a></div><figure class="code-sample"><figcaption>{t.sample}</figcaption><pre><code>{detail.query}</code></pre><div class="code-water" aria-hidden="true">~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~</div></figure></section><section class="wrap next-engines">{engines.filter(e=>engineCopy[e]!==engine).map(e=><a class="text-link" href={`/${locale}/sql/${e}/`}>{engineCopy[e].name} ↗</a>)}</section></>:slug==='graphql'?<section class="wrap coming"><p class="eyebrow">GRAPHQL / {t.soon}</p><h1>{t.graphqlTitle}</h1><p class="lead">{t.graphqlText}</p><a class="button" href={`${home}#engines`}>{t.explore} ↗</a><div class="horizon" aria-hidden="true"><span>~</span><span>~</span><span>~</span></div></section>:legal?<article class="wrap legal"><p class="eyebrow">QUERYDOCK / {t.updated}</p><h1>{title}</h1>{(slug==='privacy'?t.privacyBody:t.termsBody).map(p=><p>{p}</p>)}<p><a href="https://www.cloudflare.com/privacypolicy/">{locale==='ru'?'Политика конфиденциальности Cloudflare':'Cloudflare privacy policy'} ↗</a></p><p><a href="https://github.com/datatug/querydock-run/issues">{locale==='ru'?'Связаться через GitHub':'Contact through GitHub'} ↗</a></p></article>:null}
</Layout>
