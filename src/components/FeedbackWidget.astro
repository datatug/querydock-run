---
interface Props { locale: 'en' | 'ru' }
const {locale} = Astro.props;
---
<div class="site-feedback"><button type="button" data-feedback-launcher aria-haspopup="dialog" hidden><svg class="feedback-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="18" fill="#d4ef83"/><path d="M18 46 46 18M20 18h26v26" fill="none" stroke="#202c2a" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>{locale === 'ru' ? 'Предложить улучшение' : 'Suggest an improvement'}</button></div>
<script is:inline id="site-feedback-widget" src="https://improveit.now/widget.js" data-space="ao58m" data-app="68be5a2b72bb6213ed8378a2aa3814c0" data-lang={locale} data-color="#0d63e9" data-launcher="hidden" defer></script>
<script is:inline src="/feedback.js" defer></script>
