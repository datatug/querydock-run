---
interface Props { locale: 'en' | 'ru' }
const {locale} = Astro.props;
---
<div class="site-feedback"><button type="button" data-feedback-launcher aria-haspopup="dialog" hidden>{locale === 'ru' ? 'Предложить улучшение' : 'Suggest an improvement'}</button></div>
<script is:inline id="site-feedback-widget" src="https://improveit.now/widget.js" data-space="ao58m" data-app="68be5a2b72bb6213ed8378a2aa3814c0" data-lang={locale} data-color="#0d63e9" data-launcher="hidden" defer></script>
<script is:inline src="/feedback.js" defer></script>
